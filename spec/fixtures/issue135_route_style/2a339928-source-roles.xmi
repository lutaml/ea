					<attribute xmi:idref="EAID_E05042EC_7E43_49f8_907F_3702F204EF3B" name="partID" scope="Public">
						<initial/>
						<documentation value="主たる建築物を複数のbldg:BuildingPartに分けて記述する場合の、建築物部分を識別するための番号。bldg:BuildingPartには必須とする。"/>
						<model ea_localid="695" ea_guid="{E05042EC-7E43-49f8-907F-3702F204EF3B}"/>
