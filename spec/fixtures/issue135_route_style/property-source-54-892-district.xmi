					<tag xmi:id="EAID_ED33D65F_DF35_1ddf_9109_97872919818E" name="byValuePropertyType" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Create a named complex type ( property type ) that requires the instance to be encoded inline&#xA;" modelElement="EAID_331E7FB3_1C91_4c86_8ADD_49AA4ECD32A0"/>
					<tag xmi:id="EAID_26B33348_211E_5f21_86BD_8E443E18CBC7" name="isCollection" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Identifies the class as a collection&#xA;" modelElement="EAID_331E7FB3_1C91_4c86_8ADD_49AA4ECD32A0"/>
					<tag xmi:id="EAID_F9638764_B69A_b0b6_9834_9589568DF50D" name="noPropertyType" value="false#NOTES#Values: true,false&#xA;Default: false&#xA;Description: Suppress creation of a named complex type ( property type ) that supports inline or byReference encoding&#xA;" modelElement="EAID_331E7FB3_1C91_4c86_8ADD_49AA4ECD32A0"/>
