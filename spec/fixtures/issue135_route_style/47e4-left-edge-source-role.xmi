				<model package="EAPK_BCC79C61_EB22_4305_B574_693E41527057" tpos="0" ea_localid="478" ea_eleType="element"/>
				<properties documentation="構造物の管理に必要となる基本的な情報及び、構造物の規模に関する基本的な情報を記述するためのデータ型。 +&#xA;構造物が橋梁、トンネル、護岸、床止め、堰、水門・閘門・陸閘、樋門・樋管、伏せ越し及び水制の場合に本データ型を用いて記述する。 +&#xA;構造物がダム及び堤防の場合は、これを継承するデータ型を用いて記述する。" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="DataType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
				<project author="kurokawa" version="1.0" phase="1.0" created="2023-02-04 14:37:40" modified="2024-11-05 13:50:48" complexity="1" status="Proposed"/>
				<code product_name="Java" gentype="Java"/>
