				<model ea_localid="205"/>
				<properties ea_type="Association" direction="Destination -&gt; Source"/>
				<modifiers isRoot="false" isLeaf="false"/>
				<parameterSubstitutions/>
				<documentation value="単独木の形状を立体とし、その主要な部分の外形を面の集まり又は立体として詳細に区分して表現する。 +&#xA;一定高さごとに樹冠の横断面を作成し、この頂点を結び外形を構成する（樹冠内部の主枝等の表現は行わない）。&#xA;&#xA;.LOD3のSolitaryVegetationObjectの例&#xA;image::images/361.webp.png[width=&quot;100&quot;]&#xA;&#xA;樹木量の算定等、容積が必要ではない場合には、gml:MultiSurfaceにより外形を構成する。"/>
				<appearance linemode="3" linecolor="-1" linewidth="0" seqno="0" headStyle="0" lineStyle="0"/>
				<labels lb="0..1" lt="+lod3Geometry&#xA;«property»"/>
				<extendedProperties/>
				<style/>
				<xrefs/>
				<tags/>
			</connector>
