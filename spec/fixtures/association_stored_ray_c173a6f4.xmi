			<element xmi:idref="EAID_75DBB25D_29E9_4cb4_9813_1ACA7B4B73FD" xmi:type="uml:Class" name="DmGeometricAttribute" scope="public">
				<model package="EAPK_BCC79C61_EB22_4305_B574_693E41527057" tpos="0" ea_localid="380" ea_eleType="element"/>
				<properties documentation="都市計画基本図として、地物の形状を公共測量標準図式に従って表現するためのデータ型。 +&#xA;uro:DmGeometrictAttributeは、地物の実体を表す図形だけではなく、地物を図式に従って表現する際に必要な情報（例：建物記号、建物の棟割線、記号の方向、指示点）を含む。 +&#xA;地物（ステレオタイプがFeatureTypeとなるクラス）は、関連役割uro:dmAttributeにより、このuro:DmGeometrictAttributeを保持できる。" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="DataType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
				<project author="048827" version="1.0" phase="1.0" created="2022-06-13 05:32:36" modified="2025-02-18 16:56:39" complexity="1" status="Proposed"/>
				<code product_name="Java" gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
