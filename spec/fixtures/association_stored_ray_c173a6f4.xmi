					</attribute>
					<attribute xmi:idref="EAID_36928F1E_0E9E_4518_94E0_00B620695D26" name="is3d" scope="Public">
						<initial/>
						<documentation value="この図形の座標値が３次元データであることを示すフラグ。 +&#xA;1 ：この図形の座標値は３次元データである。 +&#xA;0 ：この図形の座標値は２次元データである。（省略時値） +&#xA;uro:is3d=0の場合、z値に示された”0”は意味を持たない。"/>
						<model ea_localid="826" ea_guid="{36928F1E-0E9E-4518-94E0-00B620695D26}"/>
