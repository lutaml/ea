					<attribute xmi:idref="EAID_85A44932_972C_43ba_951B_FA45CF6F8CAC" name="isInstallation" scope="Public">
						<initial/>
						<documentation value="この図形が地物の付属図形であることを示すフラグ。 +&#xA;付属図形とは、地物の本質的な実体ではないが、描画処理などで地物を図形表現する際に利用可能な図形である。 +&#xA;1 ：この図形は付属図形である。 +&#xA;0 ：この図形は付属図形ではない。（省略時値） +&#xA;uro:isInstallationの値が1の場合、uro:dmShapeTypeの値は、0以外となる。"/>
						<model ea_localid="827" ea_guid="{85A44932-972C-43ba-951B-FA45CF6F8CAC}"/>
						<properties type="xs:boolean" precision="0" collection="false" length="0" static="0" duplicates="0" changeability="changeable"/>
