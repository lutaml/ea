					</attribute>
					<attribute xmi:idref="EAID_C5117AFF_5BD5_4466_A468_C406B4D0B0F7" name="geometrySrcDescLod1" scope="Public">
						<initial/>
						<documentation value="LOD1の幾何オブジェクトの作成に使用した原典資料の種類。 +&#xA;コードリスト（&amp;lt;&amp;lt;DataQualityAttribute_geometrySrcDesc.xml,DataQualityAttribute_geometrySrcDesc.xml&amp;gt;&amp;gt;）より選択する。具体的な都市オブジェクトがLOD1の幾何オブジェクトを含んでいない場合でも、「未作成」を示すコード「999」を選択すること。"/>
						<model ea_localid="282" ea_guid="{C5117AFF-5BD5-4466-A468-C406B4D0B0F7}"/>
