			<element xmi:idref="EAID_D8912145_D30D_42bb_8416_D45FBA900EF1" xmi:type="uml:Class" name="ReliefFeature" scope="public">
				<model package="EAPK_F63E8324_97AB_4723_B55D_799EC71EC8AA" tpos="0" ea_localid="148" ea_eleType="element"/>
				<properties documentation="地形の凹凸を表現した地物。 +&#xA;基準地域メッシュ（第三次地域区画、一辺の長さ約1km）を地物の単位とする（基準地域メッシュの境界で区切る）。&#xA;&#xA;* 属性gml:nameは、当該エリアの標準地域メッシュコード（基準地域メッシュ）を記載する。&#xA;* 属性core:creationDateは運用上必須とする。" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="FeatureType" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
				<project author="048827" version="1.0" phase="1.0" created="2020-09-22 23:36:38" modified="2025-10-07 12:02:06" complexity="1" status="Proposed"/>
				<code product_name="Java" gentype="Java"/>
